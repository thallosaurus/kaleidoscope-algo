 <?xml version="1.0" encoding="UTF-8"?>
   <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
   <plist version="1.0">
   <dict>
       <key>Label</key>
       <string>com.lenna.tarascope</string>
       <key>ProgramArguments</key>
       <array>
	   <string>/usr/local/bin/tarascope-server</string>
       </array>
       <key>KeepAlive</key>
       <true />
       <key>RunAtLoad</key>
       <true/>
       <key>StandardOutPath</key>
       <string>/tmp/tarascope-server.out</string>
       <key>StandardErrorPath</key>
       <string>/tmp/tarascope-server.err</string>
       <key>WorkingDirectory</key>
       <string>/var/root/tarascope</string>
   </dict>
   </plist>