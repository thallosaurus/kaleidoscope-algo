{
  "tasks": {
    "server": "deno run -A --env-file main.ts",
    "still": "deno run -A --env-file render_stills.ts",
    "wallpaper": "deno run -A --env-file render_wallpaper.ts",
    "instagram": "deno run -A --env-file render_instagram_video.ts",
    "queue_random": "curl -X POST http://localhost:8000/video/random",
    "make:server": "deno compile -A --include ./loader.py --include ./kaleido_hdr.blend --include src/api/worker.ts -o dist/server main.ts"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@^0.4.0",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.9.1",
    "@std/assert": "jsr:@std/assert@1",
    "hono": "npm:hono@^4.13.13",
    "zod": "npm:zod@^4.6.5"
  }
}
